---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import { I18N } from '../../i18n.js';

export function getStaticPaths() {
  const locales = Object.keys(I18N);
  return locales.map(lang => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: string };
const t = I18N[lang as keyof typeof I18N] || I18N['en'];

// Load every locale's supplement dataset at build time and pick the one for this page.
const dataModules = import.meta.glob('../../data/supplements/*.json', { eager: true }) as Record<string, any>;
function dataFor(locale: string) {
  const key = Object.keys(dataModules).find(k => k.endsWith(`/${locale}.json`));
  return key ? dataModules[key] : null;
}
const supplements = (dataFor(lang) || dataFor('en')).supplements;
const suppById = new Map<string, any>(supplements.map((s: any) => [s.id, s]));

// Top Curated Critical Interactions & Synergies for Static SEO Pre-rendering
const FEATURED_PAIRS_CONFIG = [
  { idA: 'iron', idB: 'calcium', type: 'warning' },
  { idA: 'zinc', idB: 'copper', type: 'warning' },
  { idA: 'iron', idB: 'zinc', type: 'warning' },
  { idA: 'calcium', idB: 'magnesium_glycinate', type: 'warning' },
  { idA: 'vitamin_d3', idB: 'vitamin_k2', type: 'synergy' },
  { idA: 'iron', idB: 'vitamin_c', type: 'synergy' },
  { idA: 'magnesium_glycinate', idB: 'vitamin_d3', type: 'synergy' },
  { idA: 'vitamin_b12', idB: 'folate', type: 'synergy' }
];

const featuredPairs = FEATURED_PAIRS_CONFIG.map(cfg => {
  const a: any = suppById.get(cfg.idA);
  const b: any = suppById.get(cfg.idB);
  if (!a || !b) return null;
  
  let reason = '';
  let sources: string[] = [];
  if (cfg.type === 'warning') {
    reason = (a.interactionReasons || {})[b.id] || (b.interactionReasons || {})[a.id] || '';
    const srcOwner: any = (a.interactionReasons || {})[b.id] ? a : b;
    sources = srcOwner.sources || [];
  } else {
    reason = (a.synergyReasons || {})[b.id] || (b.synergyReasons || {})[a.id] || '';
    const srcOwner: any = (a.synergyReasons || {})[b.id] ? a : b;
    sources = srcOwner.sources || [];
  }
  return { a, b, type: cfg.type, reason, sources };
}).filter(Boolean);

const LANG_ORDER = ['en','tr','ko','ja','zh-cn','zh-tw','de','es','pt-br','it','nl','pl','ru','id','vi','th','ar'];
const alternateUrls: Record<string, string> = {};
LANG_ORDER.forEach(code => { alternateUrls[code] = `/${code}/interaction-checker/`; });

// Comprehensive FAQ localized
const checkerFaq = [
  {
    q: lang === 'tr' ? 'Demir ve Kalsiyum takviyeleri birlikte alınabilir mi?' : 'Can you take Iron and Calcium supplements together?',
    a: lang === 'tr' ? 'Hayır, demir ve kalsiyum bağırsakta aynı emilim yollarını kullanır ve yarışırlar. Kalsiyum, demir emilimini %60\'a kadar azaltabilir. İki takviye arasında en az 2 saat ara bırakılması önerilir.' : 'No, calcium competes directly with non-heme iron for intestinal absorption pathways and can reduce iron bioavailability by up to 60%. It is recommended to space them at least 2 hours apart.'
  },
  {
    q: lang === 'tr' ? 'D3 Vitamini ve K2 Vitamini neden birlikte alınmalıdır?' : 'Why should Vitamin D3 and Vitamin K2 be taken together?',
    a: lang === 'tr' ? 'D3 vitamini bağırsaktan kalsiyum emilimini artırırken, K2 vitamini (MK-7) osteokalsin proteinini aktive ederek kalsiyumun damarlar yerine kemik ve dişlere yönlendirilmesini sağlar. İkisi mükemmel bir sinerjik ikilidir.' : 'Vitamin D3 increases calcium absorption from the intestine, while Vitamin K2 (MK-7) activates osteocalcin to direct that calcium into bone tissue rather than soft tissues and arterial walls.'
  },
  {
    q: lang === 'tr' ? 'Yüksek doz Çinko neden Bakır eksikliğine yol açar?' : 'Why does high-dose Zinc supplementation cause Copper deficiency?',
    a: lang === 'tr' ? 'Kronik veya yüksek doz çinko alımı, bağırsakta metalotiyonein proteinini uyarır. Bu protein bakıra güçlü şekilde bağlanarak emilimini engeller. Uzun süreli çinko kullanımında 10:1 veya 15:1 çinko-bakır oranına dikkat edilmelidir.' : 'High-dose zinc induces metallothionein in the gut mucosa, an intracellular protein that irreversibly traps dietary copper and prevents its absorption into circulation.'
  },
  {
    q: lang === 'tr' ? 'Magnezyum ve Kalsiyum aynı anda alınır mı?' : 'Can you take Magnesium and Calcium at the same time?',
    a: lang === 'tr' ? 'Yüksek dozlarda kalsiyum ve magnezyum aynı taşıyıcı kanalları kullandıkları için birbirlerinin emilimini baskılar. Terapötik dozlarda aralarında 2 saat bırakılması veya magnezyumun akşam, kalsiyumun gündüz alınması önerilir.' : 'At high supplementary doses, calcium and magnesium compete for shared intestinal transport mechanisms. Spacing them by at least 2 hours optimizes the bioavailability of both minerals.'
  },
  {
    q: lang === 'tr' ? 'SuppTime Etkileşim Kontrolü nasıl çalışır?' : 'How does the SuppTime Interaction Checker work?',
    a: lang === 'tr' ? 'SuppTime etkileşim motoru; PubMed, NIH Office of Dietary Supplements ve hakemli klinik çalışmalar referans alınarak derlenmiş biyokimya veritabanını kullanır. Seçtiğiniz takviyeler arasındaki emilim yarışlarını, antagonist etkileri ve pozitif sinerjileri analiz eder.' : 'The SuppTime interaction engine cross-references your stack against a verified database built on peer-reviewed biomedical literature, NIH ODS monographs, and clinical trial outcomes.'
  }
];

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      "name": t.checker.title,
      "url": `https://supptime.app/${lang}/interaction-checker/`,
      "applicationCategory": "HealthApplication",
      "operatingSystem": "Any (runs in browser)",
      "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
      "description": t.checker.metaDescription,
      "isAccessibleForFree": true
    },
    {
      "@type": "FAQPage",
      "mainEntity": checkerFaq.map(item => ({
        "@type": "Question",
        "name": item.q,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": item.a
        }
      }))
    }
  ]
};

const staticSectionTitle = lang === 'tr' ? 'En Çok Araştırılan Takviye Etkileşimleri ve Sinerjiler' : 'Common Clinical Interactions & Synergies';
const staticSectionSubtitle = lang === 'tr' ? 'Klinik çalışmalar ve farmakokinetik verilere dayalı en kritik takviye kombinasyonları.' : 'Evidence-based pairings vetted against PubMed and NIH Office of Dietary Supplements databases.';
const testBtnLabel = lang === 'tr' ? 'Araçta Dene' : 'Test in Checker';
const faqTitle = lang === 'tr' ? 'Sıkça Sorulan Sorular' : 'Frequently Asked Questions';
---

<Layout title={t.checker.metaTitle} description={t.checker.metaDescription} lang={lang} dir={t.dir || 'ltr'} alternateUrls={alternateUrls}>
<script type="application/ld+json" set:html={JSON.stringify(schema)} is:inline />

<div class="page">
  <Navbar lang={lang} isBlog={true} slugLinks={alternateUrls} />

  <main class="checker-main">
    <section class="checker-hero">
      <div class="eyebrow eyebrow-dark"><span class="eyebrow-dot"></span><span>Free Tool</span></div>
      <h1 class="h1 checker-h1">{t.checker.title}</h1>
      <p class="lede checker-lede">{t.checker.subtitle}</p>
    </section>

    <section class="checker-tool">
      <div class="search-wrap glass">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="search-icon"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
        <input id="supp-search" type="text" placeholder={t.checker.searchPlaceholder} autocomplete="off" />
        <div id="search-results" class="search-results"></div>
      </div>

      <div class="stack-panel glass">
        <div class="stack-head">
          <h2>{t.checker.stackTitle}</h2>
          <button id="clear-stack" class="clear-btn" type="button">{t.checker.clearAll}</button>
        </div>
        <div id="stack-chips" class="stack-chips"></div>
        <p id="stack-empty-msg" class="stack-empty">{t.checker.stackEmpty}</p>
      </div>

      <div id="results" class="results">
        <div class="result-block warnings-block glass">
          <h3>{t.checker.warningsTitle}</h3>
          <div id="warnings-list"></div>
          <p id="no-warnings" class="no-data-msg" style="display:none;">{t.checker.noWarnings}</p>
        </div>
        <div class="result-block synergies-block glass">
          <h3>{t.checker.synergiesTitle}</h3>
          <div id="synergies-list"></div>
          <p id="no-synergies" class="no-data-msg" style="display:none;">{t.checker.noSynergies}</p>
        </div>
      </div>
    </section>

    {/* Featured Static Interactions (Crawlable by Search Engines) */}
    <section class="featured-pairs-section">
      <div class="featured-head">
        <h2 class="featured-title">{staticSectionTitle}</h2>
        <p class="featured-subtitle">{staticSectionSubtitle}</p>
      </div>
      <div class="featured-grid">
        {featuredPairs.map((p: any) => (
          <div class={`featured-card glass ${p.type === 'warning' ? 'is-warning' : 'is-synergy'}`}>
            <div class="featured-card-top">
              <span class={`type-badge ${p.type === 'warning' ? 'badge-warning' : 'badge-synergy'}`}>
                {p.type === 'warning' ? (lang === 'tr' ? '⚠️ Dikkat: Emilim Yarışı' : '⚠️ Warning: Competition') : (lang === 'tr' ? '✨ Pozitif Sinerji' : '✨ Synergistic Pair')}
              </span>
              <button type="button" class="test-pair-btn" data-a={p.a.id} data-b={p.b.id}>
                {testBtnLabel} ↑
              </button>
            </div>
            <div class="featured-pair-names">
              <span class="pair-item">{p.a.emoji || '💊'} {p.a.name}</span>
              <span class="pair-operator">+</span>
              <span class="pair-item">{p.b.emoji || '💊'} {p.b.name}</span>
            </div>
            <p class="featured-reason">{p.reason}</p>
            {p.sources?.length > 0 && (
              <p class="featured-sources"><strong>{t.checker.sourcesLabel}:</strong> {p.sources.join(', ')}</p>
            )}
          </div>
        ))}
      </div>
    </section>

    <p class="checker-disclaimer">{t.checker.disclaimer}</p>

    <section class="checker-database">
      <h2 class="checker-db-title">{t.checker.databaseTitle}</h2>
      <p class="checker-db-subtitle">{t.checker.databaseSubtitle.replace('{count}', String(supplements.length))}</p>
      <div class="checker-db-grid">
        {supplements.map((s: any) => (
          <div class="db-card glass">
            <div class="db-card-head">
              <span class="db-card-emoji">{s.emoji || '💊'}</span>
              <span class="db-card-name">{s.name}</span>
            </div>
            <p class="db-card-desc">{s.shortDescription}</p>
            {s.timing?.preferredTime && (
              <p class="db-card-timing">{s.timing.preferredTime}{s.timing.takeWithFood ? ' · with food' : ''}</p>
            )}
          </div>
        ))}
      </div>
    </section>

    {/* Frequently Asked Questions (Static HTML + FAQPage Schema) */}
    <section class="checker-faq-section glass">
      <h2 class="faq-head-title">{faqTitle}</h2>
      <div class="faq-list">
        {checkerFaq.map(item => (
          <div class="faq-item">
            <h3 class="faq-q">{item.q}</h3>
            <p class="faq-a">{item.a}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="checker-cta glass">
      <p>{t.checker.ctaText}</p>
      <a href="https://apps.apple.com/app/supptime-vitamin-tracker/id6762088156" class="btn btn-primary">
        {t.checker.ctaButton}
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14m-8-6 6 6-6 6" /></svg>
      </a>
    </section>
  </main>
</div>

<script is:inline define:vars={{ supplements, sourcesLabel: t.checker.sourcesLabel, addedBadge: t.checker.addedBadge }}>
  const byId = new Map(supplements.map(s => [s.id, s]));
  const stack = [];

  function norm(s) { return s.toLowerCase(); }

  function matches(s, query) {
    const q = norm(query);
    if (norm(s.name).includes(q)) return true;
    return (s.aliases || []).some(a => norm(a).includes(q));
  }

  function renderSearch(query) {
    const box = document.getElementById('search-results');
    if (!query.trim()) { box.style.display = 'none'; box.innerHTML = ''; return; }
    const found = supplements
      .filter(s => !stack.includes(s.id))
      .filter(s => matches(s, query))
      .slice(0, 8);
    if (found.length === 0) { box.style.display = 'none'; box.innerHTML = ''; return; }
    box.innerHTML = found.map(s =>
      `<button type="button" class="search-item" data-id="${s.id}">
        <span class="search-item-emoji">${s.emoji || '💊'}</span>
        <span class="search-item-name">${s.name}</span>
      </button>`
    ).join('');
    box.style.display = 'block';
    box.querySelectorAll('.search-item').forEach(btn => {
      btn.addEventListener('click', () => addToStack(btn.dataset.id));
    });
  }

  function addToStack(id) {
    if (stack.includes(id)) return;
    stack.push(id);
    const searchInput = document.getElementById('supp-search');
    if (searchInput) searchInput.value = '';
    renderSearch('');
    renderStack();
    renderResults();
  }

  function removeFromStack(id) {
    const idx = stack.indexOf(id);
    if (idx > -1) stack.splice(idx, 1);
    renderStack();
    renderResults();
  }

  function renderStack() {
    const chipsEl = document.getElementById('stack-chips');
    const emptyMsg = document.getElementById('stack-empty-msg');
    if (stack.length === 0) {
      chipsEl.innerHTML = '';
      emptyMsg.style.display = 'block';
      return;
    }
    emptyMsg.style.display = 'none';
    chipsEl.innerHTML = stack.map(id => {
      const s = byId.get(id);
      return `<span class="stack-chip">
        <span class="stack-chip-emoji">${s.emoji || '💊'}</span>
        <span>${s.name}</span>
        <button type="button" class="stack-chip-remove" data-id="${id}" aria-label="Remove">×</button>
      </span>`;
    }).join('');
    chipsEl.querySelectorAll('.stack-chip-remove').forEach(btn => {
      btn.addEventListener('click', () => removeFromStack(btn.dataset.id));
    });
  }

  function renderResults() {
    const resultsEl = document.getElementById('results');
    const warningsList = document.getElementById('warnings-list');
    const synergiesList = document.getElementById('synergies-list');
    const noWarnings = document.getElementById('no-warnings');
    const noSynergies = document.getElementById('no-synergies');

    if (stack.length < 2) {
      resultsEl.classList.remove('is-visible');
      return;
    }
    resultsEl.classList.add('is-visible');

    const warnings = [];
    const synergies = [];

    for (let i = 0; i < stack.length; i++) {
      for (let j = i + 1; j < stack.length; j++) {
        const a = byId.get(stack[i]);
        const b = byId.get(stack[j]);
        if (!a || !b) continue;

        const interactionReason = (a.interactionReasons || {})[b.id] || (b.interactionReasons || {})[a.id];
        const isInteraction = (a.interactions || []).includes(b.id) || (b.interactions || []).includes(a.id);
        if (isInteraction) {
          const sourceOwner = (a.interactionReasons || {})[b.id] ? a : b;
          warnings.push({ a, b, reason: interactionReason, sources: sourceOwner.sources || [] });
          continue;
        }

        const synergyReason = (a.synergyReasons || {})[b.id] || (b.synergyReasons || {})[a.id];
        const isSynergy = (a.synergies || []).includes(b.id) || (b.synergies || []).includes(a.id);
        if (isSynergy) {
          const sourceOwner = (a.synergyReasons || {})[b.id] ? a : b;
          synergies.push({ a, b, reason: synergyReason, sources: sourceOwner.sources || [] });
        }
      }
    }

    warningsList.innerHTML = warnings.map(w => `
      <div class="relation-card relation-warning">
        <div class="relation-pair">${w.a.emoji || ''} ${w.a.name} <span class="relation-plus">+</span> ${w.b.emoji || ''} ${w.b.name}</div>
        <p class="relation-reason">${w.reason || ''}</p>
        ${w.sources.length ? `<p class="relation-sources">${sourcesLabel}: ${w.sources.join(', ')}</p>` : ''}
      </div>
    `).join('');
    noWarnings.style.display = warnings.length ? 'none' : 'block';

    synergiesList.innerHTML = synergies.map(sy => `
      <div class="relation-card relation-synergy">
        <div class="relation-pair">${sy.a.emoji || ''} ${sy.a.name} <span class="relation-plus">+</span> ${sy.b.emoji || ''} ${sy.b.name}</div>
        <p class="relation-reason">${sy.reason || ''}</p>
        ${sy.sources.length ? `<p class="relation-sources">${sourcesLabel}: ${sy.sources.join(', ')}</p>` : ''}
      </div>
    `).join('');
    noSynergies.style.display = synergies.length ? 'none' : 'block';
  }

  document.getElementById('supp-search').addEventListener('input', (e) => renderSearch(e.target.value));
  document.addEventListener('click', (e) => {
    const wrap = document.querySelector('.search-wrap');
    if (wrap && !wrap.contains(e.target)) {
      document.getElementById('search-results').style.display = 'none';
    }
  });
  document.getElementById('clear-stack').addEventListener('click', () => {
    stack.length = 0;
    renderStack();
    renderResults();
  });

  // Connect static cards' "Test in Checker" buttons to interactive stack
  document.querySelectorAll('.test-pair-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const a = btn.dataset.a;
      const b = btn.dataset.b;
      if (a && b) {
        if (!stack.includes(a)) stack.push(a);
        if (!stack.includes(b)) stack.push(b);
        renderStack();
        renderResults();
        const toolEl = document.querySelector('.checker-tool');
        if (toolEl) {
          toolEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      }
    });
  });

  renderStack();
</script>

<style is:global>
  .checker-main { max-width: var(--maxw); margin: 0 auto; padding: clamp(120px, 12vw, 160px) var(--pad-x) 80px; }
  .checker-hero { max-width: 720px; margin: 0 auto 48px; text-align: center; }
  .checker-hero .eyebrow { margin: 0 auto 20px; }
  .checker-h1 { margin: 0 0 16px; }
  .checker-lede { margin: 0 auto; }

  .checker-tool { max-width: 640px; margin: 0 auto; display: flex; flex-direction: column; gap: 20px; }

  .search-wrap { position: relative; z-index: 5; display: flex; align-items: center; gap: 10px; padding: 14px 18px; }
  .search-icon { color: var(--ink-muted); flex-shrink: 0; }
  .search-wrap input {
    flex: 1; border: none; background: transparent; outline: none;
    font-family: var(--sans); font-size: 16px; color: var(--ink);
  }
  .search-results {
    display: none; position: absolute; top: calc(100% + 8px); left: 0; right: 0; z-index: 20;
    background: #fff; border-radius: var(--r-card); border: 1px solid var(--line);
    box-shadow: 0 20px 40px -12px rgba(15,23,42,0.18); overflow: hidden; max-height: 320px; overflow-y: auto;
  }
  .search-item {
    display: flex; align-items: center; gap: 12px; width: 100%; padding: 12px 18px;
    background: none; border: none; text-align: left; font-size: 15px; color: var(--ink);
    border-bottom: 1px solid var(--line);
  }
  .search-item:last-child { border-bottom: none; }
  .search-item:hover { background: var(--bg-2); }
  .search-item-emoji { font-size: 18px; }

  .stack-panel { padding: 24px; }
  .stack-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 16px; }
  .stack-head h2 { font-size: 17px; font-weight: 600; margin: 0; }
  .clear-btn { background: none; border: none; font-size: 13px; color: var(--ink-muted); font-weight: 500; cursor: pointer; }
  .clear-btn:hover { color: var(--ink); }
  .stack-chips { display: flex; flex-wrap: wrap; gap: 8px; }
  .stack-chip {
    display: inline-flex; align-items: center; gap: 8px; padding: 8px 8px 8px 12px;
    background: var(--bg-2); border-radius: var(--r-pill); font-size: 14px; font-weight: 500;
  }
  .stack-chip-emoji { font-size: 15px; }
  .stack-chip-remove {
    display: inline-flex; align-items: center; justify-content: center;
    width: 20px; height: 20px; border-radius: 50%; background: rgba(15,23,42,0.08);
    border: none; font-size: 15px; line-height: 1; color: var(--ink-soft); cursor: pointer;
  }
  .stack-chip-remove:hover { background: rgba(15,23,42,0.16); }
  .stack-empty { margin: 4px 0 0; font-size: 14px; color: var(--ink-muted); }

  .results { display: none; flex-direction: column; gap: 16px; }
  .results.is-visible { display: flex; }
  .result-block { padding: 22px 24px; }
  .result-block h3 { font-size: 15px; font-weight: 600; margin: 0 0 14px; }
  .no-data-msg { font-size: 14px; color: var(--ink-muted); margin: 0; }

  .relation-card { padding: 14px 0; border-top: 1px solid var(--line); }
  .relation-card:first-child { border-top: none; padding-top: 0; }
  .relation-pair { font-weight: 600; font-size: 14.5px; margin-bottom: 6px; }
  .relation-plus { color: var(--ink-muted); font-weight: 400; margin: 0 2px; }
  .relation-reason { font-size: 14px; line-height: 1.6; color: var(--ink-soft); margin: 0 0 4px; }
  .relation-sources { font-size: 12px; color: var(--ink-muted); margin: 0; font-family: var(--mono); }

  .warnings-block { border: 1px solid oklch(0.75 0.12 40 / 0.35); background: oklch(0.98 0.02 60 / 0.7); }
  .synergies-block { border: 1px solid var(--emerald-soft); background: var(--emerald-tint); }

  /* Featured Static Section for Crawlers & UX */
  .featured-pairs-section { max-width: 860px; margin: 56px auto 0; }
  .featured-head { text-align: center; margin-bottom: 28px; }
  .featured-title { font-size: 22px; font-weight: 700; margin: 0 0 8px; }
  .featured-subtitle { font-size: 14px; color: var(--ink-muted); margin: 0; }
  .featured-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(360px, 1fr)); gap: 16px; }
  .featured-card { padding: 20px; border-radius: 16px; display: flex; flex-direction: column; }
  .featured-card.is-warning { border-left: 4px solid #f59e0b; background: rgba(254, 243, 199, 0.35); }
  .featured-card.is-synergy { border-left: 4px solid #10b981; background: rgba(209, 250, 229, 0.35); }
